# Secrets and settings for the docker compose stack. Copy to .env and fill in the secrets:
#
#   cp .env.example .env
#
# Compose reads ./.env automatically. `.env` is gitignored — never commit it.
#
# The three required values. Generate each one separately; never reuse the examples, never reuse a
# value across environments:
#
#   POSTGRES_PASSWORD   openssl rand -hex 16    (also embedded in the api's DATABASE_URL)
#   JWT_SECRET          openssl rand -hex 32    (rotating it invalidates every issued token)
#   ADMIN_PASSWORD      openssl rand -hex 12    (re-applied to the admin account on every boot)
#
# Hex (not base64) on purpose: these values end up inside a URL and in a password box, so keep them
# free of characters that need escaping.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD=

# Rotating: JWT_SECRET and ADMIN_PASSWORD take effect on the next `docker compose up -d` (the seeder
# re-applies the admin password on boot). POSTGRES_PASSWORD does not — Postgres only sets it when it
# first initialises the data directory, so after editing it either update the role in place:
#
#   docker compose exec -T db psql -U wallet -d wallet -c "ALTER ROLE wallet WITH PASSWORD '<new value>'"
#   docker compose up -d api          # so the api picks up the new DATABASE_URL
#
# or start over with `docker compose down -v`, which drops the data.

# Optional, with correct defaults for local use.
ADMIN_USERNAME=admin
# Comma separated. Every spelling of the dashboard is a *different* origin to a browser: `localhost`,
# `127.0.0.1` and `[::1]` are three origins even though they reach the same port, and one that is
# missing fails with "blocked by CORS policy" only in the browser. List each address you actually type.
# A real deployment lists its https origin instead, e.g. https://wallet.example.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:4000/api/v1
