# Copy to .env (never commit .env) and adjust for your machine.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Homebrew Postgres has no `postgres` role by default: the role is your
# OS user, and Prisma (unlike libpq/pg) does not default the user, so name it explicitly.
DATABASE_URL=postgres://YOUR_PG_USER@localhost:5432/wallet
# Used by `npm run test:integration`; the database is created automatically if missing.
TEST_DATABASE_URL=postgres://YOUR_PG_USER@localhost:5432/wallet_test
DB_POOL_MAX=10

# JWT signing. MUST be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Browser origin allowed to call the API (comma separated list, or * for any).
CORS_ORIGIN=http://localhost:5173

# Admin account created by `npm run seed` and by the API on boot (idempotent).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
