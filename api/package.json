{
  "name": "crypto-wallet-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for a simple crypto wallet (register, balance, topup, transfer, reporting)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed-admin.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
